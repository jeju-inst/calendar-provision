# Google Calendar
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
CALENDAR_VIEWER_DIRECTORY_SUBJECT=calendar-reader@example.com

# Optional Slack lifecycle notifications
SLACK_BOT_TOKEN=
GW_NOTIFY_OPERATOR=
CALENDAR_VIEWER_SLACK_ENV=.env

# Optional Monday project catalog sync
MONDAY_API_TOKEN=
MONDAY_PROGRESS_BOARD_ID=1234567890
MONDAY_RELATION_COLUMN_ID=board_relation_xxxxx
MONDAY_CODE_COLUMN_ID=lookup_code
MONDAY_PM_COLUMN_ID=lookup_pm
PROJECT_CATALOG_LIMIT=2000
